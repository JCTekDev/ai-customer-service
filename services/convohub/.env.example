# convohub environment example
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8080

# Supervisor LLM settings
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_TIMEOUT=300
SUPERVISOR_MODEL=llama3.1
SUPERVISOR_TEMPERATURE=0.2
SUPERVISOR_MAX_STEPS=6

# Supervisor system prompt
SUPERVISOR_SYSTEM_PROMPT=You are the Supervisor. Decide which tool to call based on the user's intent:\n- Use info_agent for FAQs or general company/customer information.\n- Use calendar_scheduler for availability checking and meeting scheduling.\nOutput: If a tool is needed, respond with: TOOL:<tool_name>:<user_query>. Otherwise answer directly.

# Info-Agent settings
INFO_AGENT_MODEL=llama3.1
INFO_AGENT_SYSTEM_PROMPT=You are an FAQ assistant. Answer clearly, concisely, and politely.
INFO_AGENT_RECENT_MESSAGES_WINDOW=6
INFO_AGENT_TOKEN_BUDGET=8192
INFO_AGENT_SUMMARY_TOKEN_BUDGET=800
INFO_AGENT_MESSAGES_TO_SUMMARIZE=8
INFO_AGENT_SUMMARIZATION_PROMPT_TOKENS=100
INFO_AGENT_MESSAGE_SUMMARY_CHAR_LIMIT=600
REDIS_URL=redis://redis-stack.redis-stack-dev.svc.cluster.local:6379/0

# Calendar Scheduler settings
CALENDAR_ID=primary
DEFAULT_MEETING_DURATION_MINUTES=30
TIMEZONE=UTC
GOOGLE_CALENDAR_CREDENTIALS_FILE=./credentials.json

# WAHA Adapter settings
WAHA_API_KEY=changeme
WAHA_BASE_URL=http://waha:3000
WAHA_RESPONSE_TIMEOUT=30
